pipeline {
    agent any

    parameters {
        booleanParam(name: 'NO_CACHE', defaultValue: false, description: 'Docker build cache kullanma')
        booleanParam(name: 'DEPLOY', defaultValue: true, description: 'Build sonrasi deploy yap')
    }

    environment {
        DOCKER_IMAGE = 'mstfaock/hirovo-frontend'
        DOCKER_TAG = 'latest'
        CONTAINER_NAME = 'hirovo-frontend'

        SERVER_SSH_KEY_ID = 'maden-server-key'
        SERVER_HOST_ID = 'dev-server-host'
        DOCKERHUB_CRED = 'dockerhub-credentials'
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '20'))
        timeout(time: 1, unit: 'HOURS')
        timestamps()
    }

    stages {
        stage('Checkout') {
            steps {
                script {
                    echo "Hirovo frontend kodu cekiliyor..."
                    sh '''
                        echo "Kod basariyla cekildi"
                        echo "Branch: ${GIT_BRANCH}"
                        echo "Commit: ${GIT_COMMIT}"
                    '''
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    echo "Hirovo frontend Docker image build ediliyor..."

                    def cacheArgs = params.NO_CACHE ? '--no-cache' : ''

                    timeout(time: 20, unit: 'MINUTES') {
                        sh """
                            docker build \
                                ${cacheArgs} \
                                --file _devops/docker/Dockerfile \
                                --tag ${DOCKER_IMAGE}:${DOCKER_TAG} \
                                --build-arg NEXT_PUBLIC_API_URL=https://api.hirovo.com \
                                --build-arg NEXT_PUBLIC_STRAPI_URL=https://cms.hirovo.com \
                                --build-arg NEXT_PUBLIC_COMPANY_ID=c9d8c846-10fc-466d-8f45-a4fa4e856abd \
                                .
                        """
                    }

                    echo "Docker image basariyla build edildi"
                }
            }
        }

        stage('Push to Docker Hub') {
            steps {
                script {
                    echo "Docker image push ediliyor..."

                    withCredentials([usernamePassword(
                        credentialsId: env.DOCKERHUB_CRED,
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )]) {
                        sh """
                            echo "\$DOCKER_PASS" | docker login -u "\$DOCKER_USER" --password-stdin
                            docker push ${DOCKER_IMAGE}:${DOCKER_TAG}
                            docker logout
                        """
                    }
                }
            }
        }

        stage('Deploy') {
            when {
                expression { params.DEPLOY == true }
            }
            steps {
                script {
                    echo "Hirovo frontend deploy basliyor..."

                    withCredentials([
                        sshUserPrivateKey(credentialsId: env.SERVER_SSH_KEY_ID, keyFileVariable: 'SSH_KEY', usernameVariable: 'SSH_USER'),
                        string(credentialsId: env.SERVER_HOST_ID, variable: 'SERVER_HOST')
                    ]) {
                        def sshUser = SSH_USER
                        def sshHost = SERVER_HOST

                        sh """
                            chmod 600 "\$SSH_KEY"

                            ssh -o StrictHostKeyChecking=no -i "\$SSH_KEY" ${sshUser}@${sshHost} bash <<'ENDSSH'
set -e

echo "Eski container durduruluyor..."
docker stop ${CONTAINER_NAME} 2>/dev/null || true
docker rm ${CONTAINER_NAME} 2>/dev/null || true

echo "Yeni image cekiliyor..."
docker pull ${DOCKER_IMAGE}:${DOCKER_TAG}

echo "Yeni container baslatiliyor..."
docker run -d \
    --name ${CONTAINER_NAME} \
    --restart unless-stopped \
    -p 3000:3000 \
    -e NEXT_PUBLIC_API_URL=https://api.hirovo.com \
    -e NEXT_PUBLIC_STRAPI_URL=https://cms.hirovo.com \
    ${DOCKER_IMAGE}:${DOCKER_TAG}

echo "Container baslatildi"
docker ps | grep ${CONTAINER_NAME}
ENDSSH
                        """
                    }
                }
            }
        }

        stage('Health Check') {
            when {
                expression { params.DEPLOY == true }
            }
            steps {
                script {
                    echo "Health check yapiliyor..."

                    withCredentials([
                        sshUserPrivateKey(credentialsId: env.SERVER_SSH_KEY_ID, keyFileVariable: 'SSH_KEY', usernameVariable: 'SSH_USER'),
                        string(credentialsId: env.SERVER_HOST_ID, variable: 'SERVER_HOST')
                    ]) {
                        def sshUser = SSH_USER
                        def sshHost = SERVER_HOST

                        sh """
                            chmod 600 "\$SSH_KEY"

                            ssh -o StrictHostKeyChecking=no -i "\$SSH_KEY" ${sshUser}@${sshHost} bash <<'ENDSSH'
set -e

echo "Container durumu kontrol ediliyor..."
sleep 5

if docker ps | grep -q ${CONTAINER_NAME}; then
    echo "Container calisiyor"
    curl -sf http://localhost:3000 > /dev/null && echo "Health check basarili!" || echo "Health check bekleniyor..."
else
    echo "Container calismadi!"
    docker logs ${CONTAINER_NAME} 2>&1 | tail -20
    exit 1
fi
ENDSSH
                        """
                    }
                }
            }
        }

        stage('Cleanup') {
            steps {
                script {
                    echo "Eski image'lar temizleniyor..."
                    sh """
                        docker image prune -f || true
                    """
                }
            }
        }
    }

    post {
        success {
            echo "Hirovo Frontend Pipeline basariyla tamamlandi!"
            echo "Build ID: ${BUILD_ID}"
            echo "Commit: ${GIT_COMMIT}"
            echo "URL: https://hirovo.com"
        }
        failure {
            echo "Hirovo Frontend Pipeline basarisiz oldu!"
            echo "Build ID: ${BUILD_ID}"
            echo "Commit: ${GIT_COMMIT}"
        }
    }
}
